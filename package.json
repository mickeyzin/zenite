{
  "name": "zenite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:lattafa": "NODE_USE_ENV_PROXY=1 node scripts/importers/lattafa.mjs",
    "db:seed:build": "esbuild scripts/db/build-seed.ts --bundle --platform=node --format=esm --outfile=scripts/db/.build-seed.mjs --log-level=warning && node scripts/db/.build-seed.mjs",
    "db:test": "node scripts/db/test-rls.mjs --seed",
    "db:test:roundtrip": "esbuild scripts/db/test-roundtrip.ts --bundle --platform=node --format=esm --external:@electric-sql/pglite --external:@supabase/supabase-js --alias:@=./src --alias:next/cache=./scripts/db/stub-next-cache.mjs --outfile=scripts/db/.test-roundtrip.mjs --log-level=warning && node scripts/db/.test-roundtrip.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.0",
    "next": "16.4.2",
    "postprocessing": "^6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@gltf-transform/cli": "^4.5.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
